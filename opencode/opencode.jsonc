{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@henkey/postgres-mcp-server"],
      "enabled": true,
      "environment": {
        "POSTGRES_CONNECTION_STRING": "{file:.secrets/neon-conn-str.txt}"
      }
    },
    "youtube-transcript": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://youtube-transcript.ai/mcp"],
      "enabled": true
    },
    "fin": {
      "type": "local",
      "command": ["fin-mcp"],
      "enabled": true
    }
  }
}
