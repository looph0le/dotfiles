{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#00061c",
    "bg2": "#282e44",
    "fg": "#ffffff",
    "accent": "#427edc",
    "blue1": "#3362aa",
    "blue2": "#7390dc",
    "blue3": "#8db1ea",
    "muted": "#5970aa",
    "lavender": "#aa96dc",
    "pink": "#dc82a5",
    "mauve": "#d7b2d0",
    "rose": "#aa6580"
  },
  "theme": {
    "primary": { "dark": "accent", "light": "accent" },
    "secondary": { "dark": "blue3", "light": "blue3" },
    "accent": { "dark": "accent", "light": "accent" },
    "error": { "dark": "pink", "light": "pink" },
    "warning": { "dark": "muted", "light": "muted" },
    "success": { "dark": "lavender", "light": "lavender" },
    "info": { "dark": "blue3", "light": "blue3" },
    "text": { "dark": "fg", "light": "bg" },
    "textMuted": { "dark": "muted", "light": "blue2" },
    "background": { "dark": "bg", "light": "fg" },
    "backgroundPanel": { "dark": "bg", "light": "bg2" },
    "backgroundElement": { "dark": "bg2", "light": "mauve" },
    "border": { "dark": "bg2", "light": "muted" },
    "borderActive": { "dark": "accent", "light": "accent" },
    "borderSubtle": { "dark": "bg2", "light": "muted" },
    "diffAdded": { "dark": "lavender", "light": "lavender" },
    "diffRemoved": { "dark": "pink", "light": "pink" },
    "diffContext": { "dark": "muted", "light": "muted" },
    "diffHunkHeader": { "dark": "muted", "light": "muted" },
    "diffHighlightAdded": { "dark": "lavender", "light": "lavender" },
    "diffHighlightRemoved": { "dark": "pink", "light": "pink" },
    "diffAddedBg": { "dark": "bg", "light": "bg" },
    "diffRemovedBg": { "dark": "bg", "light": "bg" },
    "diffContextBg": { "dark": "bg", "light": "bg" },
    "diffLineNumber": { "dark": "blue2", "light": "muted" },
    "diffAddedLineNumberBg": { "dark": "bg", "light": "bg" },
    "diffRemovedLineNumberBg": { "dark": "bg", "light": "bg" },
    "markdownText": { "dark": "fg", "light": "bg" },
    "markdownHeading": { "dark": "accent", "light": "accent" },
    "markdownLink": { "dark": "blue3", "light": "blue3" },
    "markdownLinkText": { "dark": "lavender", "light": "lavender" },
    "markdownCode": { "dark": "lavender", "light": "lavender" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "pink", "light": "pink" },
    "markdownStrong": { "dark": "fg", "light": "fg" },
    "markdownHorizontalRule": { "dark": "accent", "light": "accent" },
    "markdownListItem": { "dark": "accent", "light": "accent" },
    "markdownListEnumeration": { "dark": "accent", "light": "accent" },
    "markdownImage": { "dark": "blue3", "light": "blue3" },
    "markdownImageText": { "dark": "lavender", "light": "lavender" },
    "markdownCodeBlock": { "dark": "fg", "light": "bg" },
    "syntaxComment": { "dark": "muted", "light": "muted" },
    "syntaxKeyword": { "dark": "accent", "light": "accent" },
    "syntaxFunction": { "dark": "blue3", "light": "blue3" },
    "syntaxVariable": { "dark": "mauve", "light": "mauve" },
    "syntaxString": { "dark": "lavender", "light": "lavender" },
    "syntaxNumber": { "dark": "pink", "light": "pink" },
    "syntaxType": { "dark": "mauve", "light": "mauve" },
    "syntaxOperator": { "dark": "accent", "light": "accent" },
    "syntaxPunctuation": { "dark": "fg", "light": "bg" }
  }
}
